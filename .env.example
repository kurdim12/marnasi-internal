# Cloudflare account
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# API Worker — use `wrangler secret put <NAME>` for production, .dev.vars locally
JWT_SECRET=change-me-256-bits-of-random
PASSWORD_PEPPER=change-me-32-bytes-of-random
ORG_MASTER_KEY=change-me-base64-32-bytes
TURNSTILE_SECRET_KEY=
MAILCHANNELS_DKIM_PRIVATE_KEY=

# Web app (Next.js on Cloudflare Pages)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_APP_NAME=Maranasi Intranet
