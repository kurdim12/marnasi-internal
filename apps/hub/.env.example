# Maranasi Hub — environment

# Demo auth (Phase 1). Override in production; wire to a real auth backend.
HUB_SESSION_SECRET=change-me-to-a-long-random-string
HUB_DEMO_PASSWORD=maranasi

# Default UI language
NEXT_PUBLIC_DEFAULT_LANG=en

# ---------------------------------------------------------------------------
# The integrations below are specified by the brief and consumed by the
# proposal pipeline (Phases 3+). They are NOT required to run the Phase 1/2
# demo, which is driven by typed seed fixtures.
# ---------------------------------------------------------------------------

# Anthropic Claude (server-side only)
# ANTHROPIC_API_KEY=

# Presenton (deck generation)
# PRESENTON_API_URL=
# PRESENTON_USERNAME=
# PRESENTON_PASSWORD=

# Cloudflare R2 (deck/asset storage)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=maranasi-assets
# R2_PUBLIC_URL=

# Feature flag — live Presenton generation vs. pre-baked deck (brief 7.7)
# USE_LIVE_GENERATION=false
